# .env.example — MODELO das variáveis do projeto (este arquivo VAI para o GitHub).
# Para usar: copie para um arquivo chamado .env (que NÃO vai para o GitHub).
#   Windows (PowerShell): Copy-Item .env.example .env
#   Git Bash / Mac / Linux: cp .env.example .env

# Endereço da loja (front). Termina com / para o page.goto('loja.html') funcionar.
LOJA_URL=https://alisonmelo.github.io/tioalison-pe-t4-fap26/projetos-base/01-sistema-login/

# Endereço da API. Termina com /api/ -> nos testes use request.get('products') SEM barra.
API_URL=https://api-qa-fap2026.onrender.com/api/

# Cliente de teste (massa pública da própria tela de login da Loja QA)
CLIENTE_EMAIL=user@system.com
CLIENTE_SENHA=UserPassword123

# Atraso entre ações do robô, em ms. 0 = rápido; 400 = ritmo para a banca enxergar.
SLOWMO=0

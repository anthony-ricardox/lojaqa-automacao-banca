# .env.example — MODELO das variáveis do projeto (este arquivo VAI para o GitHub).
# Para usar, copie para um arquivo chamado .env (que NÃO vai para o GitHub):
#   PowerShell:            Copy-Item .env.example .env
#   Git Bash / Mac / Linux: cp .env.example .env

# Endereço da Loja QA (front). Termina com / para o page.goto('loja.html') funcionar.
LOJA_URL=https://alisonmelo.github.io/tioalison-pe-t4-fap26/projetos-base/01-sistema-login/

# Endereço da API da Loja. Termina com /api/: nos testes, use request.get('products') SEM barra.
API_URL=https://api-qa-fap2026.onrender.com/api/

# Cliente de teste: e-mail e senha estão impressos na própria tela de login da Loja QA.
# A senha de verdade vai só no seu .env (que não sobe para o GitHub).
CLIENTE_EMAIL=user@system.com
CLIENTE_SENHA=coloque-a-senha-aqui

# API pública do desafio de mercado (pasta rick-and-morty/). Opcional: este já é o padrão.
RICK_MORTY_URL=https://rickandmortyapi.com/api/

# Vitrine do Rick and Morty: mostra cada resposta (fotos, status, JSON) na tela do UI Mode
# ou numa janela com --headed. 0 = desliga: os testes voltam a ser só API, sem navegador.
VITRINE=1

# Atraso entre as ações do robô, em ms. 0 = rápido; 400 = ritmo para a banca enxergar.
SLOWMO=0

# 1 = grava vídeo, print e trace de TODOS os testes (evidência para o Jira). 0 = só quando falha.
EVIDENCIA=0
